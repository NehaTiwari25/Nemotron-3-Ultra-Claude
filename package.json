{
  "name": "second-opinion-mcp",
  "version": "0.1.0",
  "description": "An MCP server that gives your coding agent a second opinion from a different model.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "second-opinion-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node scripts/test-sources.mjs && node scripts/test-throttle.mjs && node scripts/smoke.mjs",
    "review": "node scripts/review-file.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "code-review",
    "nemotron",
    "openrouter"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
